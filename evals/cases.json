    {
      "id": "chart-latency",
      "category": "chart",
      "image": "fixtures/chart-latency.png",
      "question": "Extract every region's P95 latency and identify the highest value.",
      "assertions": [
        { "field": "all", "contains": "eu-west" },
        { "field": "quantitativeFacts", "contains": "eu-west is 120 ms" },
        { "field": "quantitativeFacts", "contains": "us-east is 180 ms" },
        { "field": "quantitativeFacts", "contains": "ap-south is 240 ms" },
        { "field": "quantitativeFacts", "contains": "ap-northeast is 150 ms" },
        { "field": "quantitativeFacts", "contains": "highest value is ap-south at 240 ms" }
      ],
      "oracleEvidence": {
        "schemaVersion": "deepseekeyes.evidence.v1",
        "summary": "A P95 API latency bar chart compares four regions; ap-south has the tallest bar.",
        "ocr": [
          { "text": "API latency by region (ms)", "bbox": [0.04, 0.04, 0.5, 0.07], "confidence": 1 },
          { "text": "eu-west 120", "bbox": [0.11, 0.35, 0.18, 0.5], "confidence": 1 },
          { "text": "us-east 180", "bbox": [0.29, 0.27, 0.18, 0.58], "confidence": 1 },
          { "text": "ap-south 240", "bbox": [0.47, 0.19, 0.18, 0.66], "confidence": 1 },
          { "text": "ap-northeast 150", "bbox": [0.65, 0.31, 0.2, 0.54], "confidence": 1 }
        ],
        "regions": [
          { "id": "plot", "bbox": [0.1, 0.21, 0.81, 0.66], "description": "Bar plot with a 0 to 300 millisecond vertical axis." }
        ],
        "objects": [
          { "name": "ap-south bar", "bbox": [0.47, 0.32, 0.12, 0.53], "attributes": ["purple", "highest"] }
        ],
        "relations": ["The ap-south bar is taller than the other three bars."],
        "quantitativeFacts": [
          "eu-west is 120 ms.",
          "us-east is 180 ms.",
          "ap-south is 240 ms.",
          "ap-northeast is 150 ms.",
          "The highest value is ap-south at 240 ms."
        ],
        "uncertainties": []
      }
    },
    {
