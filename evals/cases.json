  "cases": [
    {
      "id": "screenshot-error-dialog",
      "category": "screenshot",
      "image": "fixtures/screenshot-error-dialog.png",
      "question": "Extract the exact failure, location, retry instruction and available action.",
      "assertions": [
        { "field": "ocr", "contains": "DSE-5042" },
        { "field": "ocr", "contains": "503 Service Unavailable" },
        { "field": "ocr", "contains": "ap-southeast-1" },
        { "field": "ocr", "contains": "Retry after: 30 seconds" },
        { "field": "ocr", "contains": "View logs" }
      ],
      "oracleEvidence": {
        "schemaVersion": "deepseekeyes.evidence.v1",
        "summary": "A deployment overview screenshot shows Job #4821 failed with an orange error panel and a View logs action.",
        "ocr": [
          { "text": "Deployment overview", "bbox": [0.06, 0.17, 0.3, 0.06], "confidence": 1 },
          { "text": "Job #4821", "bbox": [0.06, 0.24, 0.15, 0.04], "confidence": 1 },
          { "text": "Deployment failed", "bbox": [0.24, 0.35, 0.35, 0.07], "confidence": 1 },
          { "text": "ERROR CODE: DSE-5042", "bbox": [0.24, 0.45, 0.35, 0.04], "confidence": 1 },
          { "text": "HTTP STATUS: 503 Service Unavailable", "bbox": [0.24, 0.51, 0.5, 0.04], "confidence": 1 },
          { "text": "Region: ap-southeast-1", "bbox": [0.24, 0.57, 0.36, 0.04], "confidence": 1 },
          { "text": "Retry after: 30 seconds", "bbox": [0.24, 0.63, 0.35, 0.04], "confidence": 1 },
          { "text": "View logs", "bbox": [0.69, 0.71, 0.14, 0.06], "confidence": 1 }
        ],
        "regions": [
          { "id": "error-panel", "bbox": [0.13, 0.31, 0.74, 0.51], "description": "Orange bordered deployment failure panel." }
        ],
        "objects": [
          { "name": "View logs button", "bbox": [0.69, 0.71, 0.14, 0.06], "attributes": ["orange", "enabled"] }
        ],
        "relations": ["The View logs button belongs to the deployment failure panel."],
        "quantitativeFacts": ["HTTP status is 503.", "Retry delay is 30 seconds.", "Job number is 4821."],
        "uncertainties": []
      }
    },
    {
