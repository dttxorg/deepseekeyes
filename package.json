{
  "name": "deepseekeyes",
  "version": "0.1.1-alpha.2",
  "description": "A transparent multimodal vision bridge for DeepSeek Harness that keeps image bytes intact and lets DeepSeek request visual clarification in one conversation.",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./core": "./src/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "dsh",
    "src",
    "lib",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "npm run build:client && node scripts/verify-package.mjs && npm test",
    "pack:dry": "npm pack --dry-run",
    "pack:release": "npm pack",
    "build:client": "node scripts/build-client.mjs",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "vision",
    "multimodal",
    "image",
    "ocr"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
